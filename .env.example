# BadBlue Environment Variables Template
# Copy this file to .env and fill in your actual values

# ═══════════════════════════════════════════════════════
# DATABASE CONFIGURATION (PostgreSQL) - REQUIRED
# ═══════════════════════════════════════════════════════

DATABASE_URL=postgresql://user:password@host:5432/database
PGHOST=your-db-host.example.com
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGDATABASE=your_database_name

# ═══════════════════════════════════════════════════════
# AI SERVICE API KEYS - REQUIRED
# ═══════════════════════════════════════════════════════

GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# ═══════════════════════════════════════════════════════
# STRIPE PAYMENT CONFIGURATION - REQUIRED
# ═══════════════════════════════════════════════════════

STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
VITE_STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
TESTING_STRIPE_SECRET_KEY=sk_test_your_test_stripe_secret_key
TESTING_VITE_STRIPE_PUBLIC_KEY=pk_test_your_test_stripe_public_key

# ═══════════════════════════════════════════════════════
# EMAIL CONFIGURATION (SMTP) - REQUIRED
# ═══════════════════════════════════════════════════════

GWSMTP_USER=your-email@example.com
GWSMTP_PASS=your-email-password

# ═══════════════════════════════════════════════════════
# SESSION MANAGEMENT - REQUIRED
# ═══════════════════════════════════════════════════════

SESSION_SECRET=generate-a-long-random-string-here

# ═══════════════════════════════════════════════════════
# OBJECT STORAGE CONFIGURATION - OPTIONAL
# ═══════════════════════════════════════════════════════

DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id
PUBLIC_OBJECT_SEARCH_PATHS=/path/to/public
PRIVATE_OBJECT_DIR=/path/to/private

# ═══════════════════════════════════════════════════════
# ADDITIONAL DATABASES - OPTIONAL
# ═══════════════════════════════════════════════════════

SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/database

# ═══════════════════════════════════════════════════════
# REPLIT OAUTH CONFIGURATION - OPTIONAL
# ═══════════════════════════════════════════════════════
#
# These variables are ONLY needed if running on Replit platform.
# When migrating off Replit, leave these commented out.
# The app will automatically use local authentication instead.
#
# REPLIT_DOMAINS=your-repl-domain.repl.co
# REPL_ID=your-repl-id
# ISSUER_URL=https://replit.com/oidc

# ═══════════════════════════════════════════════════════
# RUNTIME CONFIGURATION - REQUIRED
# ═══════════════════════════════════════════════════════

NODE_ENV=production
PORT=5000
